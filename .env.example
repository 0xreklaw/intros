# Copy to .env and fill in the blanks. Every value below works as is for local development,
# except the two API keys.

# --- Database ---------------------------------------------------------------------------
# The app connects as a restricted role so row-level security applies to every query.
DATABASE_URL=postgresql://intros_app:intros_app@localhost:5433/intros
# The owner role, used only by `npm run db:migrate`.
MIGRATION_DATABASE_URL=postgresql://intros:intros@localhost:5433/intros

# --- Object storage (raw API responses) ---------------------------------------------------
# Local emulator below. For Cloudflare R2 use the account's S3 endpoint, region auto, and
# S3_FORCE_PATH_STYLE=false. The bucket must already exist.
S3_ENDPOINT=http://localhost:9090
S3_REGION=auto
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_BUCKET=intros-data
S3_FORCE_PATH_STYLE=true

# --- treg (https://treg.to): finds people, accounts and profiles --------------------------
# Leave empty to turn off every paid lookup.
TREG_API_KEY=
TREG_BASE_URL=https://treg.to

# --- OpenRouter (https://openrouter.ai): reads and judges people ----------------------------
# Search needs this key. Leave empty and search is switched off.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional stronger model for the review agent. It must support tool calling.
OPENROUTER_AGENT_MODEL=

# --- App --------------------------------------------------------------------------------
# One workspace serves everyone. It is created on first visit.
APP_TENANT_SLUG=default
APP_TENANT_NAME=My team
# Password for the whole app (basic auth, any username). Required when running in production.
APP_PASSWORD=
